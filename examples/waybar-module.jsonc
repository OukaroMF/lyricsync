{
  "group/lyrics": {
    "orientation": "vertical",
    "modules": [
      "custom/lyrics-secondary",
      "custom/lyrics-original"
    ]
  },
  "custom/lyrics-secondary": {
    "exec": "$HOME/.local/bin/lyricsync -output secondary",
    "return-type": "json",
    "restart-interval": 2,
    "exec-on-event": false,
    "escape": false,
    "on-click": "$HOME/.local/bin/lyricsync toggle",
    "tooltip": true,
    "max-length": 80
  },
  "custom/lyrics-original": {
    "exec": "$HOME/.local/bin/lyricsync -output original",
    "return-type": "json",
    "restart-interval": 2,
    "exec-on-event": false,
    "escape": false,
    "on-click": "$HOME/.local/bin/lyricsync toggle",
    "tooltip": true,
    "max-length": 80
  }
}
